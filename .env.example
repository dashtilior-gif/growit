# GrowIt environment variables
# Copy this file to `.env.local` for local dev, and add the same vars to Vercel.

# 1. Create a free Supabase project: https://supabase.com
# 2. Project Settings → API → copy these two values.
# 3. Run supabase/schema.sql in the SQL Editor once.

# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Prefer the SERVICE ROLE key server-side (bypasses RLS, full access).
# Use the ANON key (public) for browser-only features.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional (browser / public fallback):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY